/* ==========================================================================
   CYBERPUNK & VAPORWAVE ULTRA-DELUXE CSS FRAMEWORK
   Core Variables, Resets, Components, Animations, and Utility Classes
========================================================================== */

:root {
  /* Core Colors */
  --bg-base: #050505;
  --bg-surface: #0f0f13;
  --text-main: #e0e0e0;
  --text-muted: #888890;
  
  /* Cyberpunk Neons */
  --neon-cyan: #00f3ff;
  --neon-cyan-dim: rgba(0, 243, 255, 0.4);
  --neon-pink: #ff003c;
  --neon-pink-dim: rgba(255, 0, 60, 0.4);
  --neon-yellow: #fcee0a;
  --neon-yellow-dim: rgba(252, 238, 10, 0.4);
  --neon-purple: #b026ff;
  --neon-green: #39ff14;

  /* Glassmorphism */
  --glass-bg: rgba(15, 15, 19, 0.65);
  --glass-border: rgba(0, 243, 255, 0.25);
  --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);

  /* CRT & Effects */
  --crt-line: rgba(255, 255, 255, 0.03);
  --scanline-color: rgba(0, 0, 0, 0.5);
}

/* =========================================
   RESETS & BASE
========================================= */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-base);
  color: var(--text-main);
  font-family: 'Courier New', Consolas, 'Monaco', monospace;
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* =========================================
   TYPOGRAPHY
========================================= */
h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 1rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

p { margin-bottom: 1rem; }
a { color: var(--neon-cyan); text-decoration: none; transition: all 0.3s; }
a:hover { color: var(--neon-pink); text-shadow: 0 0 8px var(--neon-pink); }

/* =========================================
   COMPONENTS: CRT & SCANLINES
========================================= */
.crt-container {
  position: relative;
  min-height: 100vh;
  width: 100%;
  overflow: hidden;
}

.crt-container::before {
  content: "";
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    to bottom,
    var(--scanline-color) 50%,
    transparent 50%
  );
  background-size: 100% 4px;
  z-index: 9998;
  pointer-events: none;
}

.crt-container::after {
  content: "";
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle, rgba(0,0,0,0) 60%, rgba(0,0,0,0.4) 100%);
  z-index: 9999;
  pointer-events: none;
}

/* =========================================
   COMPONENTS: NEON TEXT
========================================= */
.text-neon-cyan {
  color: #fff;
  text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px var(--neon-cyan), 0 0 40px var(--neon-cyan), 0 0 80px var(--neon-cyan);
}

.text-neon-pink {
  color: #fff;
  text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px var(--neon-pink), 0 0 40px var(--neon-pink), 0 0 80px var(--neon-pink);
}

.text-neon-yellow {
  color: #fff;
  text-shadow: 0 0 5px #fff, 0 0 10px var(--neon-yellow), 0 0 20px var(--neon-yellow), 0 0 40px var(--neon-yellow);
}

/* =========================================
   COMPONENTS: CYBER BUTTONS
========================================= */
.btn-cyber {
  position: relative;
  display: inline-block;
  padding: 1rem 2rem;
  background: transparent;
  color: var(--neon-cyan);
  border: 2px solid var(--neon-cyan);
  font-family: inherit;
  font-size: 1.25rem;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 2px;
  cursor: pointer;
  overflow: hidden;
  transition: all 0.3s ease;
  z-index: 1;
}

.btn-cyber::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: var(--neon-cyan);
  z-index: -1;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.3s ease-in-out;
}

.btn-cyber:hover {
  color: var(--bg-base);
  box-shadow: 0 0 20px var(--neon-cyan);
}

.btn-cyber:hover::before {
  transform: scaleX(1);
  transform-origin: left;
}

.btn-cyber-pink {
  color: var(--neon-pink);
  border-color: var(--neon-pink);
}
.btn-cyber-pink::before { background: var(--neon-pink); }
.btn-cyber-pink:hover { box-shadow: 0 0 20px var(--neon-pink); color: #fff; }

/* =========================================
   COMPONENTS: GLASSMORPHISM
========================================= */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  box-shadow: var(--glass-shadow);
  padding: 2rem;
  position: relative;
  overflow: hidden;
}

.glass-panel::before {
  content: '';
  position: absolute;
  top: 0; left: -100%; width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  transform: skewX(-20deg);
  animation: glass-shine 6s infinite;
}

/* =========================================
   KEYFRAME ANIMATIONS (Dozens of Effects)
========================================= */

/* 1. Glitch Effect Core */
.glitch-wrapper { position: relative; display: inline-block; }
.glitch-text {
  position: relative;
  font-size: 4rem;
  font-weight: bold;
  color: #fff;
  text-transform: uppercase;
}
.glitch-text::before, .glitch-text::after {
  content: attr(data-text);
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: var(--bg-base);
}
.glitch-text::before {
  left: 3px;
  text-shadow: -2px 0 var(--neon-pink);
  clip: rect(24px, 550px, 90px, 0);
  animation: glitch-anim-1 3s infinite linear alternate-reverse;
}
.glitch-text::after {
  left: -3px;
  text-shadow: -2px 0 var(--neon-cyan);
  clip: rect(85px, 550px, 140px, 0);
  animation: glitch-anim-2 2.5s infinite linear alternate-reverse;
}

@keyframes glitch-anim-1 {
  0% { clip: rect(15px, 9999px, 94px, 0); transform: skew(0.2deg); }
  5% { clip: rect(77px, 9999px, 21px, 0); transform: skew(0.5deg); }
  10% { clip: rect(3px, 9999px, 83px, 0); transform: skew(0.1deg); }
  15% { clip: rect(41px, 9999px, 50px, 0); transform: skew(0.8deg); }
  20% { clip: rect(98px, 9999px, 12px, 0); transform: skew(0.3deg); }
  25% { clip: rect(27px, 9999px, 66px, 0); transform: skew(0.6deg); }
  30% { clip: rect(66px, 9999px, 34px, 0); transform: skew(0.2deg); }
  35% { clip: rect(12px, 9999px, 88px, 0); transform: skew(0.7deg); }
  40% { clip: rect(88px, 9999px, 5px, 0); transform: skew(0.1deg); }
  45% { clip: rect(45px, 9999px, 77px, 0); transform: skew(0.4deg); }
  50% { clip: rect(9px, 9999px, 44px, 0); transform: skew(0.9deg); }
  55% { clip: rect(55px, 9999px, 99px, 0); transform: skew(0.2deg); }
  60% { clip: rect(33px, 9999px, 22px, 0); transform: skew(0.5deg); }
  65% { clip: rect(71px, 9999px, 61px, 0); transform: skew(0.3deg); }
  70% { clip: rect(19px, 9999px, 80px, 0); transform: skew(0.8deg); }
  75% { clip: rect(82px, 9999px, 15px, 0); transform: skew(0.1deg); }
  80% { clip: rect(5px, 9999px, 55px, 0); transform: skew(0.6deg); }
  85% { clip: rect(61px, 9999px, 33px, 0); transform: skew(0.4deg); }
  90% { clip: rect(94px, 9999px, 71px, 0); transform: skew(0.2deg); }
  95% { clip: rect(22px, 9999px, 9px, 0); transform: skew(0.7deg); }
  100% { clip: rect(44px, 9999px, 88px, 0); transform: skew(0.3deg); }
}

@keyframes glitch-anim-2 {
  0% { clip: rect(65px, 9999px, 100px, 0); transform: skew(0.5deg); }
  10% { clip: rect(12px, 9999px, 50px, 0); transform: skew(0.2deg); }
  20% { clip: rect(89px, 9999px, 20px, 0); transform: skew(0.7deg); }
  30% { clip: rect(34px, 9999px, 70px, 0); transform: skew(0.1deg); }
  40% { clip: rect(78px, 9999px, 10px, 0); transform: skew(0.9deg); }
  50% { clip: rect(23px, 9999px, 80px, 0); transform: skew(0.3deg); }
  60% { clip: rect(56px, 9999px, 30px, 0); transform: skew(0.6deg); }
  70% { clip: rect(90px, 9999px, 60px, 0); transform: skew(0.4deg); }
  80% { clip: rect(5px, 9999px, 90px, 0); transform: skew(0.8deg); }
  90% { clip: rect(45px, 9999px, 40px, 0); transform: skew(0.2deg); }
  100% { clip: rect(80px, 9999px, 15px, 0); transform: skew(0.5deg); }
}

/* 2. Flicker & Flash */
.anim-flicker { animation: flicker-anim 2s infinite alternate; }
@keyframes flicker-anim {
  0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
  20%, 24%, 55% { opacity: 0.1; }
}

.anim-flash { animation: flash-anim 0.5s infinite; }
@keyframes flash-anim {
  0%, 50%, 100% { opacity: 1; }
  25%, 75% { opacity: 0; }
}

/* 3. Screen Shake */
.anim-shake { animation: shake-anim 0.4s cubic-bezier(.36,.07,.19,.97) both infinite; }
@keyframes shake-anim {
  0% { transform: translate(0, 0); }
  20% { transform: translate(-2px, 2px); }
  40% { transform: translate(2px, -2px); }
  60% { transform: translate(-2px, -2px); }
  80% { transform: translate(2px, 2px); }
  100% { transform: translate(0, 0); }
}

/* 4. 3D Rotation */
.anim-spin-3d { animation: spin-3d-anim 8s linear infinite; transform-style: preserve-3d; }
@keyframes spin-3d-anim {
  0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
  100% { transform: rotateX(360deg) rotateY(360deg) rotateZ(360deg); }
}

/* 5. Glass Shine */
@keyframes glass-shine {
  0% { left: -100%; }
  20% { left: 200%; }
  100% { left: 200%; }
}

/* 6. Pulse Neon */
.anim-pulse-neon { animation: pulse-neon-anim 2s infinite; }
@keyframes pulse-neon-anim {
  0% { box-shadow: 0 0 0 0 var(--neon-cyan-dim); }
  70% { box-shadow: 0 0 0 20px rgba(0, 243, 255, 0); }
  100% { box-shadow: 0 0 0 0 rgba(0, 243, 255, 0); }
}

